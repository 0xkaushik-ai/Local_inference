+extern "C" void devicebench_q4k_avx512_gemv(int n, float * output, size_t,
+        const void * weights, const void * activations, int nr, int nc) {
+    assert(n % QK_K == 0);
+    assert(nc % 8 == 0);
+    assert(nr == 1); // The repacked GEMV caller handles each activation row separately.
+    (void) nr;
+    const int blocks = n / QK_K;
+    const auto * inputs = static_cast<const block_q8_K *>(activations);
+    const auto * packed_weights = static_cast<const block_q4_Kx8 *>(weights);
+
+    for (int group = 0; group < nc / 8; ++group) {
+        const block_q4_Kx8 * columns = packed_weights + group * blocks;
+        __m256 float_dots = _mm256_setzero_ps();
+        __m256 float_mins = _mm256_setzero_ps();
+        for (int block = 0; block < blocks; ++block) {
+            const block_q4_Kx8 & weight = columns[block];
+            const block_q8_K & input = inputs[block];
+            __m512i scaled_dots = _mm512_setzero_si512();
+            __m256i min_correction = _mm256_setzero_si256();
+            for (int subblock = 0; subblock < 4; ++subblock) {
+                const __m128i scale_low = devicebench_avx512_scales(weight.scales + 24 * subblock);
+                const __m128i scale_high = devicebench_avx512_scales(weight.scales + 24 * subblock + 12);
+                const __m512i scale_low_lanes = _mm512_cvtepu8_epi32(_mm_unpacklo_epi8(scale_low, scale_low));
+                const __m512i scale_high_lanes = _mm512_cvtepu8_epi32(_mm_unpacklo_epi8(scale_high, scale_high));
+
+                __m512i low_even = _mm512_setzero_si512();
+                __m512i low_odd = _mm512_setzero_si512();
+                __m512i high_even = _mm512_setzero_si512();
+                __m512i high_odd = _mm512_setzero_si512();
+                const uint8_t * quants = weight.qs + 256 * subblock;
+                const int8_t * input_quants = input.qs + 64 * subblock;
+                devicebench_avx512_dot_part(quants, input_quants, 0, low_even, high_even);
+                devicebench_avx512_dot_part(quants, input_quants, 1, low_odd, high_odd);
+                devicebench_avx512_dot_part(quants, input_quants, 2, low_even, high_even);
+                devicebench_avx512_dot_part(quants, input_quants, 3, low_odd, high_odd);
+
+                const __m512i low_dot = _mm512_add_epi32(low_even, low_odd);
+                const __m512i high_dot = _mm512_add_epi32(high_even, high_odd);
+                scaled_dots = _mm512_add_epi32(scaled_dots, _mm512_add_epi32(
+                    _mm512_mullo_epi32(low_dot, scale_low_lanes),
+                    _mm512_mullo_epi32(high_dot, scale_high_lanes)));
+
+                const __m256i low_mins = _mm256_cvtepu8_epi32(_mm_srli_si128(scale_low, 8));
+                const __m256i high_mins = _mm256_cvtepu8_epi32(_mm_srli_si128(scale_high, 8));
+                const int low_sum = int(input.bsums[subblock * 4]) + input.bsums[subblock * 4 + 1];
+                const int high_sum = int(input.bsums[subblock * 4 + 2]) + input.bsums[subblock * 4 + 3];
+                min_correction = _mm256_add_epi32(min_correction, _mm256_add_epi32(
+                    _mm256_mullo_epi32(low_mins, _mm256_set1_epi32(low_sum)),
+                    _mm256_mullo_epi32(high_mins, _mm256_set1_epi32(high_sum))));
+            }
+
+            // Each pair contains disjoint integer partial sums for one column.
+            // Worst-case absolute total is 256 * 15 * 128 * 63 < INT32_MAX.
+            const __m512i pair_sums = _mm512_add_epi32(scaled_dots, _mm512_srli_epi64(scaled_dots, 32));
+            const __m256i integer_dots = _mm512_cvtepi64_epi32(pair_sums);
+            const __m256 input_scale = _mm256_set1_ps(input.d);
+            const __m256 weight_scale = _mm256_cvtph_ps(_mm_loadu_si128(
+                reinterpret_cast<const __m128i *>(weight.d)));
+            const __m256 weight_min = _mm256_cvtph_ps(_mm_loadu_si128(
+                reinterpret_cast<const __m128i *>(weight.dmin)));
+            // Match upstream exactly: separate dot/min FMA chains in block order,
+            // identical scale multiplication, and one subtraction after all blocks.
+            float_dots = _mm256_fmadd_ps(_mm256_cvtepi32_ps(integer_dots),
+                _mm256_mul_ps(weight_scale, input_scale), float_dots);
+            float_mins = _mm256_fmadd_ps(_mm256_cvtepi32_ps(min_correction),
+                _mm256_mul_ps(weight_min, input_scale), float_mins);
+        }
+        _mm256_storeu_ps(output + group * 8, _mm256_sub_ps(float_dots, float_mins));
+    }
+}
