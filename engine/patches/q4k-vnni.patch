+// DeviceBench candidate for the existing eight-byte Q4_K weight interleave.
+// This function is embedded in the reproducible experiment patch; no repacking
+// or GEMM change is required.
+#include "../../repack.h"
+
+#include <cassert>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <immintrin.h>
+
+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VNNI__) && \
+    defined(__AVX2__) && defined(__F16C__) && defined(__FMA__)
+
+// The repacked 12-byte record decodes to [s0..s7, min0..min7].
+static inline __m128i devicebench_avx512_scales(const uint8_t * packed) {
+    uint32_t values[4];
+    std::memcpy(values, packed, 12);
+    values[3] = ((values[2] >> 4) & 0x0f0f0f0f) | (((values[1] >> 6) & 0x03030303) << 4);
+    const uint32_t upper_mins = values[1] & 0x3f3f3f3f;
+    values[1] = (values[2] & 0x0f0f0f0f) | (((values[0] >> 6) & 0x03030303) << 4);
+    values[2] = upper_mins;
+    values[0] &= 0x3f3f3f3f;
+    return _mm_set_epi32(values[3], values[2], values[1], values[0]);
+}
+
+static inline __m512i devicebench_avx512_broadcast_q8(const int8_t * source) {
+    int64_t bytes;
+    std::memcpy(&bytes, source, sizeof(bytes));
+    return _mm512_set1_epi64(bytes);
+}
+
+static inline void devicebench_avx512_dot_part(const uint8_t * weights,
+        const int8_t * activations, int part, __m512i & low, __m512i & high) {
+    // Eight consecutive bytes per column, with eight columns per 64-byte load.
+    // VNNI produces two int32 lanes per column; keep those lanes until the
+    // complete 256-element block has been scaled and accumulated.
+    const __m512i packed = _mm512_loadu_si512(weights + part * 64);
+    const __m512i nibble_mask = _mm512_set1_epi8(15);
+    const __m512i q4_low = _mm512_and_si512(packed, nibble_mask);
+    const __m512i q4_high = _mm512_and_si512(_mm512_srli_epi16(packed, 4), nibble_mask);
+    low = _mm512_dpbusd_epi32(low, q4_low,
+        devicebench_avx512_broadcast_q8(activations + part * 8));
+    high = _mm512_dpbusd_epi32(high, q4_high,
+        devicebench_avx512_broadcast_q8(activations + 32 + part * 8));
+}
+
+extern "C" bool devicebench_q4k_avx512_available() {
+    return true;
+}
